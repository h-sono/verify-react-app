{
  "compilerOptions": {
    "target": "es6",                  // コンパイル後のJavaScriptのバージョン
    "module": "commonjs",             // モジュールの形式
    "moduleResolution": "node",       // モジュールの解決方法
    "rootDir": "./src",               // ソースコードのルートディレクトリ
    "strict": true,                   // 厳密な型チェックを有効にする
    "esModuleInterop": true,          // ESモジュールとCommonJSモジュールの互換性
    "skipLibCheck": true,             // 型定義ファイルのチェックをスキップ
    "forceConsistentCasingInFileNames": true, // ファイル名の大文字と小文字を一貫性を持たせる
		"jsx": "react",                   // JSX を処理するためのオプション
    "allowJs": true,                   // JavaScript ファイルもコンパイルする場合に設定
    // "baseUrl": ".",                   // モジュール解決の基準ディレクトリ
    // "paths": {                        // モジュールのパスエイリアス
    //   "@components/*": ["src/components/*"],
    //   "@store/*": ["src/store/*"]
    // }
  },
	"include": [
    "src/**/*"                        // コンパイルするファイルのパターン
  ],
  "exclude": [
    "node_modules",                   // コンパイルから除外するディレクトリ
    "**/*.test.ts"                    // テストファイルの除外
  ]
}
